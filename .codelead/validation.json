{
  "scopes": {
    "CloudWars.Characterization.Db": [
      {
        "label": "dotnet build (net48)",
        "command": "dotnet",
        "args": [
          "build",
          "-nologo",
          "-v",
          "q"
        ]
      },
      {
        "label": "mono xunit (net48)",
        "command": "mono",
        "args": [
          "/Users/peter/.nuget/packages/xunit.runner.console/2.9.2/tools/net472/xunit.console.exe",
          "bin/Debug/net48/CloudWars.Characterization.Db.dll",
          "-nologo"
        ],
        "platforms": [
          "darwin",
          "linux"
        ]
      },
      {
        "label": "xunit (dotnet test, net48, Windows)",
        "command": "dotnet",
        "args": [
          "test",
          "-f",
          "net48",
          "-nologo"
        ],
        "platforms": [
          "win32"
        ],
        "note": "needs the SQL Server connection; step 2 of the Windows smoke"
      }
    ],
    ".": [
      {
        "label": "build Common (both targets)",
        "command": "dotnet",
        "args": [
          "build",
          "CloudWars.Common/CloudWars.Common.csproj",
          "-nologo",
          "-v",
          "q"
        ]
      },
      {
        "label": "build Entities (both targets)",
        "command": "dotnet",
        "args": [
          "build",
          "CloudWars.Entities/CloudWars.Entities.csproj",
          "-nologo",
          "-v",
          "q"
        ]
      },
      {
        "label": "build DataAccess (both targets)",
        "command": "dotnet",
        "args": [
          "build",
          "CloudWars.DataAccess/CloudWars.DataAccess.csproj",
          "-nologo",
          "-v",
          "q"
        ]
      },
      {
        "label": "build SpaceBattle (both targets)",
        "command": "dotnet",
        "args": [
          "build",
          "CloudWars.SpaceBattle/CloudWars.SpaceBattle.csproj",
          "-nologo",
          "-v",
          "q"
        ]
      },
      {
        "label": "pins in-memory (dotnet test, net8.0)",
        "command": "dotnet",
        "args": [
          "test",
          "CloudWars.Characterization/CloudWars.Characterization.csproj",
          "-nologo"
        ]
      },
      {
        "label": "pins database (build net48)",
        "command": "dotnet",
        "args": [
          "build",
          "CloudWars.Characterization.Db/CloudWars.Characterization.Db.csproj",
          "-nologo",
          "-v",
          "q"
        ]
      },
      {
        "label": "pins database (mono xunit, net48)",
        "command": "mono",
        "args": [
          "/Users/peter/.nuget/packages/xunit.runner.console/2.9.2/tools/net472/xunit.console.exe",
          "CloudWars.Characterization.Db/bin/Debug/net48/CloudWars.Characterization.Db.dll",
          "-nologo"
        ],
        "platforms": [
          "darwin",
          "linux"
        ]
      },
      {
        "label": "pins database (dotnet test, net8.0)",
        "command": "dotnet",
        "args": [
          "test",
          "CloudWars.Characterization.Db/CloudWars.Characterization.Db.csproj",
          "-f",
          "net8.0",
          "-nologo"
        ],
        "platforms": [
          "darwin",
          "linux"
        ]
      }
    ]
  },
  "note": "Windows (backlog plan wave 1.1, 2026-09-22): the Mono runner does not exist there and the database pins need the SQL Server connection, so those entries run on darwin/linux only; Windows runs the builds and the in-memory pins on both targets. The database pins on Windows are step 2 of the smoke (dotnet test -f net48 once connections.local.config points at a reachable SQL Server)."
}
